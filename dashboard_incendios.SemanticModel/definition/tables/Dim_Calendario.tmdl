		summarizeBy: none
		sourceColumn: [Nº estación]

	column 'Año corto'
		dataType: string
		lineageTag: 9a50fb53-4c76-4bd2-b349-c6ce3e90a550
		summarizeBy: none
		sourceColumn: [Año corto]
		sortByColumn: Año

	partition Dim_Calendario = calculated
		mode: import
		source =
				VAR _ini = YEAR(MIN(incendios[Fecha detección]))
				VAR _fin = YEAR(MAX(incendios[Fecha detección]))
				RETURN
				SELECTCOLUMNS(
				    CALENDAR(DATE(_ini, 1, 1), DATE(_fin, 12, 31)),
				    "Fecha", [Date],
				    "Año", YEAR([Date]),
				    "Año corto", "'" & RIGHT(YEAR([Date]), 2),
				    "Mes nº", MONTH([Date]),
				    "Mes", FORMAT([Date], "mmmm", "es-ES"),
				    "Mes corto", FORMAT([Date], "mmm", "es-ES"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "Estación", SWITCH(TRUE(), MONTH([Date]) IN {12, 1, 2}, "Invierno", MONTH([Date]) IN {3, 4, 5}, "Primavera", MONTH([Date]) IN {6, 7, 8}, "Verano", "Otoño"),
				    "Nº estación", SWITCH(TRUE(), MONTH([Date]) IN {12, 1, 2}, 4, MONTH([Date]) IN {3, 4, 5}, 1, MONTH([Date]) IN {6, 7, 8}, 2, 3)
				)

